{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@deepseek-ai/schemastery": [
        "./node_modules/@deepseek-ai/schemastery/lib/types/index.d.ts"
      ],
      "@deepseek-ai/cosmokit": [
        "./node_modules/@deepseek-ai/cosmokit/lib/types/index.d.ts"
      ]
    }
  }
}
